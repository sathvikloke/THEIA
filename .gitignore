# Generated reader-study materials. The KEY file maps token -> arm and
# would unblind the study for anyone with repo access, so it must not be
# tracked. The previous pattern was anchored to the repo root and never
# matched theia/reader_study/cases/, so the key was committed once.
**/reader_study/cases/
*.tcia

# Frozen-token cache for the pooling sweep: 57 MB, regenerated in ~2 min
# by theia.analysis.pooling_sweep. Derived data, not a result.
results/_token_cache.npz

# Outreach drafts stay local until sent — they name real people and
# contain negotiating posture that should not be public before the email is.
docs/OUTREACH.md
